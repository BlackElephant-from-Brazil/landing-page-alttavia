# Copy to .env.local and fill in what the phase you are working on needs.
# .env* is gitignored, so no value here ever reaches a commit. In production
# these live in the Netlify environment, never in a file.
#
# Test mode and live mode are separate worlds in Stripe: different keys,
# different price ids, different webhook secrets. Keep .env.local on test
# values and let Netlify hold the live ones.

# ===========================================================================
# Site
# ===========================================================================
# Absolute origin, used to build the Stripe success and cancel URLs and any
# link inside an email. Left empty the code falls back to the request origin,
# which is right for local dev and for Netlify deploy previews.
NEXT_PUBLIC_SITE_URL=

# ===========================================================================
# Supabase                                                  (accounts phase)
# ===========================================================================
# Project dgdbrnvgrpixsslgvmns: Postgres for questions, services and orders,
# Auth for the email code login. Dashboard, Project Settings, API keys.
#
# The URL and the publishable key are public by design (they reach the
# browser); row level security decides what a user can read with them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses row level security, so it is the key that writes
# orders, payments and documents after a route handler has checked the
# session. Never NEXT_PUBLIC_, never imported from a client component.
SUPABASE_SECRET_KEY=

# Personal access token (Dashboard, Account, Access Tokens). Read only by
# `npm run db:migrate` and the MCP server, never by the site.
SUPABASE_ACCESS_TOKEN=

# ===========================================================================
# Stripe                                                    (checkout phase)
# ===========================================================================
# The four hosted checkout links the wizard sends buyers to.
#
# Leave them EMPTY in production: the code falls back to the live links baked
# into src/content/bank-nif.ts. Fill them in .env.local with the TEST links
# (they contain /test_) so nothing you click on localhost takes real money.
# `npm run stripe:setup` creates them and prints this block ready to paste.
NEXT_PUBLIC_CHECKOUT_NIF_ONLY=
NEXT_PUBLIC_CHECKOUT_BUNDLE=
NEXT_PUBLIC_CHECKOUT_BANK_ONLY=
NEXT_PUBLIC_CHECKOUT_COUPLE=

# Dashboard, Developers, API keys, Secret key. sk_test_ locally, sk_live_ in
# production. Only the webhook needs it; the checkout itself is hosted by
# Stripe and needs no key at all.
STRIPE_SECRET_KEY=

# Printed by `npm run stripe:setup`. Run it once per mode.
STRIPE_PRICE_NIF_ONLY=
STRIPE_PRICE_BUNDLE=
STRIPE_PRICE_BANK_ONLY=
STRIPE_PRICE_COUPLE=

# Given when the webhook endpoint is created. Locally it is a different value,
# printed by `stripe listen --forward-to localhost:3100/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=

# ===========================================================================
# Email                                                        (email phase)
# ===========================================================================
# Provider still to be chosen (Resend, Postmark or SES). The key name stays
# generic until then, so only this line changes when it is decided.
EMAIL_API_KEY=
# Sender on the authenticated domain, for example orders@alttavia-relocation.com
EMAIL_FROM=
# Where a customer reply lands.
EMAIL_REPLY_TO=
# Internal address that gets the new order notification.
EMAIL_TEAM_INBOX=

# ===========================================================================
# Document storage                                            (upload phase)
# ===========================================================================
# Cloudflare R2 or S3, both speak the S3 API, so these names fit either.
# Private bucket: passports and proof of income live here.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Signs the magic link that lets a customer come back to their upload page.
# Any long random string: `node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"`
UPLOAD_TOKEN_SECRET=

# ===========================================================================
# Analytics                                                   (launch phase)
# ===========================================================================
# Only loaded when set, so an empty value simply means no tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
