# Copy to .env.local and fill in. .env* is gitignored: no key ever goes in a commit.
# In production these live in the Netlify environment, not in a file.

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Dashboard, Developers, API keys. Test mode and live mode have different keys
# and different price ids, so keep .env.local on test keys and let Netlify hold
# the live ones.
STRIPE_SECRET_KEY=sk_test_

# Printed by `node scripts/stripe-setup.mjs`. Run it once per mode.
STRIPE_PRICE_NIF_ONLY=price_
STRIPE_PRICE_BUNDLE=price_
STRIPE_PRICE_BANK_ONLY=price_
STRIPE_PRICE_COUPLE=price_

# Given when you create the webhook endpoint. Locally it is printed by
# `stripe listen --forward-to localhost:3100/api/stripe/webhook`, and it is a
# different value there than in the Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin used to build the Stripe success and cancel URLs. Leave the
# localhost value here; Netlify sets the real one.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
