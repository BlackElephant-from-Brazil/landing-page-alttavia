# Copy to .env.local and fill in what the phase you are working on needs.
# .env* is gitignored, so no value here ever reaches a commit. In production
# these live in the Netlify environment, never in a file.
#
# Test mode and live mode are separate worlds in Stripe: different keys,
# different price ids, different webhook secrets. Keep .env.local on test
# values and let Netlify hold the live ones.

# ===========================================================================
# Site
# ===========================================================================
# Absolute origin, used to build the Stripe success and cancel URLs, the
# login redirects of the download links and any link inside an email
# (src/lib/site-url.ts). REQUIRED on Netlify's production deploy:
#   NEXT_PUBLIC_SITE_URL=https://bank-nif-portugal.alttavia-relocation.com
# There, an empty value is an error the moment a URL is needed (checkout
# fails with a 500 and the log names this variable) instead of a guess from a
# request header. Left empty everywhere else, the code falls back to the
# origin the browser used, which is right for local dev (localhost or the LAN
# address, never 0.0.0.0) and for Netlify deploy previews.
NEXT_PUBLIC_SITE_URL=

# Set by Netlify on every build and function, never by hand: production,
# deploy-preview, branch-deploy or dev. Only `production` changes behaviour
# (NEXT_PUBLIC_SITE_URL becomes required). Leave it out of .env.local.
# CONTEXT=

# ===========================================================================
# Supabase                                                  (accounts phase)
# ===========================================================================
# Project dgdbrnvgrpixsslgvmns: Postgres for questions, services and orders,
# Auth for the email code login. Dashboard, Project Settings, API keys.
#
# The URL and the publishable key are public by design (they reach the
# browser); row level security decides what a user can read with them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses row level security, so it is the key that writes
# orders, payments and documents after a route handler has checked the
# session. Never NEXT_PUBLIC_, never imported from a client component.
SUPABASE_SECRET_KEY=

# Personal access token (Dashboard, Account, Access Tokens). Read only by
# `npm run db:migrate` and the MCP server, never by the site.
SUPABASE_ACCESS_TOKEN=

# ===========================================================================
# Stripe                                                    (checkout phase)
# ===========================================================================
# The four hosted checkout links the wizard sends buyers to.
#
# Leave them EMPTY in production: the code falls back to the live links baked
# into src/content/bank-nif.ts. Fill them in .env.local with the TEST links
# (they contain /test_) so nothing you click on localhost takes real money.
# `npm run stripe:setup` creates them and prints this block ready to paste.
NEXT_PUBLIC_CHECKOUT_NIF_ONLY=
NEXT_PUBLIC_CHECKOUT_BUNDLE=
NEXT_PUBLIC_CHECKOUT_BANK_ONLY=
NEXT_PUBLIC_CHECKOUT_COUPLE=

# Dashboard, Developers, API keys, Secret key. sk_test_ locally, sk_live_ in
# production (a restricted rk_live_ key works too). The prefix decides the
# mode: sk_live_ and rk_live_ are live, anything else is test, and the live
# or test price id of each service is picked to match. Used to open Checkout
# Sessions (POST /api/checkout), to confirm them on return and by the webhook.
STRIPE_SECRET_KEY=

# Printed by `npm run stripe:setup`. Run it once per mode.
STRIPE_PRICE_NIF_ONLY=
STRIPE_PRICE_BUNDLE=
STRIPE_PRICE_BANK_ONLY=
STRIPE_PRICE_COUPLE=

# Given when the webhook endpoint is created. Locally it is a different value,
# printed by `stripe listen --forward-to localhost:3100/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=

# ===========================================================================
# Email                                                        (email phase)
# ===========================================================================
# Resend, send only key. The name stays generic so a change of provider only
# touches src/lib/email/send.ts and this line.
EMAIL_API_KEY=
# Sender on the authenticated domain, for example hello@send.alttavia-relocation.com
EMAIL_FROM=
# Where a customer reply lands.
EMAIL_REPLY_TO=
# Where team notices go: a new paid order, a full set of documents ready for
# review, a signed service agreement, with the file attached only on an order
# paid with real money (src/lib/orders/notify.ts). One address. Locally set
# it to the test inbox, business@guyshore.com, so development mail never
# reaches the firm.
# Empty, the team notice is skipped with one log line; the client email still
# goes.
EMAIL_TEAM_INBOX=
# Where feedback sent from the admin goes: the Feedback button on every admin
# page (src/lib/email/feedback.ts). Locally business@guyshore.com as well.
# Empty, the note is still saved and listed on /admin/feedback, only the
# email is skipped.
FEEDBACK_TO=

# ===========================================================================
# Admin second factor                                          (admin phase)
# ===========================================================================
# "1" asks every admin for a code from an authenticator app at sign in, and
# leads an admin without one through the set up on /admin/login
# (src/lib/supabase/admin-user.ts). Only the exact value 1 turns it on. Empty,
# only an admin who set up a second factor at /admin/settings is asked, and
# that admin always is. Set it on Netlify only after every admin account has
# enrolled. The app reads it; the database does not (0015_admin_mfa.sql asks
# the code of an enrolled admin either way).
ADMIN_REQUIRE_MFA=

# ===========================================================================
# Support admin                                                (local only)
# ===========================================================================
# The developer's own admin account (business+admin@guyshore.com), used by
# scripts and test runs to sign in to /admin. Written into .env.local by
# `npm run admin:create -- --support`, which sets a new password on every run
# and never prints it. The site never reads these three. Never set them on
# Netlify.
ADMIN_SUPPORT_EMAIL=
ADMIN_SUPPORT_PASSWORD=
# The secret of the support admin's second factor, written by
# `npm run admin:totp` before it verifies the factor and never printed;
# scripts/authz-matrix.mjs computes the codes from it to sign in at aal2.
ADMIN_SUPPORT_TOTP_SECRET=

# ===========================================================================
# Document storage                                            (upload phase)
# ===========================================================================
# Cloudflare R2 or S3, both speak the S3 API, so these names fit either.
# Private bucket: passports and proof of income live here, and the firm's
# signature for the service agreements at firm/signature.png, uploaded with
# `npm run firm:signature -- <file.png>` and read only for orders paid with
# real money.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Signs the magic link that lets a customer come back to their upload page.
# Any long random string: `node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"`
# Not read by the code today: uploads run behind the account login instead.
UPLOAD_TOKEN_SECRET=

# ===========================================================================
# Analytics                                                   (launch phase)
# ===========================================================================
# Only loaded when set, so an empty value simply means no tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
